rule CXX_STATIC_LIBRARY_LINKER__video_core_Release
  command = $PRE_LINK && /opt/android-sdk/cmake/3.22.1/bin/cmake -E rm -f $TARGET_FILE && /opt/android-sdk/ndk/29.0.14206865/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar qc $TARGET_FILE $LINK_FLAGS $in && /opt/android-sdk/ndk/29.0.14206865/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ranlib $TARGET_FILE && $POST_BUILD
  description = Linking CXX static library $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /opt/android-sdk/cmake/3.22.1/bin/cmake --regenerate-during-build -S/home/nava/Files/code/active/VideoPlayer/android -B/home/nava/Files/code/active/VideoPlayer/android/app/.cxx/Release/37282h3z/arm64-v8a
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /opt/android-sdk/cmake/3.22.1/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /opt/android-sdk/cmake/3.22.1/bin/ninja -t targets
  description = All primary targets available:

