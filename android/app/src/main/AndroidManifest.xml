<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sideload-only (never Play Store). Video files live wherever the user
         put them; "All files access" is the honest permission for that, rather
         than a SAF tree grant that would make every path a content:// URI the
         portable Demuxer cannot open. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application android:label="Video Player">
        <!-- Our AppShellActivity subclass, not the base class and not the bare
             NativeActivity. The base is what asks for the HDR colour mode below
             and what resolves a content:// URI into bytes; the SUBCLASS is what
             loads the native library into the Java runtime, without which every
             one of the base class's native methods throws at runtime. See
             VideoPlayerActivity.java. -->
        <activity
            android:name="io.nava.videoplayer.VideoPlayerActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="Video Player">
            <meta-data
                android:name="android.app.lib_name"
                android:value="video_player_android" />
            <!-- Opt in to an HDR window. Without this the driver never
                 ENUMERATES the HDR10 surface formats, resolve_output_target()
                 finds nothing to pick and pins SDR — and the log line would say
                 the device does not support HDR when in truth we never asked.
                 A request, not a guarantee: hdrActive() is the answer. -->
            <meta-data
                android:name="io.nava.appshell.HDR"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Opened from a file manager, which sends ACTION_VIEW with a
                 content:// URI rather than the "video_path" extra a developer
                 launch uses. Both are handled; see
                 PlayerWindow::openWhateverWeWereLaunchedWith().

                 Two filters, because a file manager decides the MIME type by
                 asking the media database, not by looking at the file. A
                 Matroska recording comes through as video/x-matroska on one
                 device, video/mp4 on another, and application/octet-stream
                 when nothing recognised it — so matching only the exact type
                 means the app is simply absent from the "open with" list on
                 most phones. Anything it cannot actually decode is declined
                 with a message, which is the better failure. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
